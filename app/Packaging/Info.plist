<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for Microfish.app/Contents/Info.plist. app/Scripts/build-app.sh replaces the @TOKENS@. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Microfish</string>
	<key>CFBundleExecutable</key>
	<string>Microfish</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>@APP_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Microfish</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD_VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MIN_MACOS@</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Microfish contributors. Released under the MIT License.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>SUFeedURL</key>
	<string>@FEED_URL@</string>
	<key>SUPublicEDKey</key>
	<string>@SPARKLE_PUBLIC_KEY@</string>
	<!-- Checks start on with a visible switch in Settings › Updates, so Sparkle never asks on second launch.
	     Automatic download and install stays off until the user turns it on. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- The appcast is signed with the same EdDSA key as the archives (release workflow, publish job), and the
	     app refuses a feed whose signature does not verify against SUPublicEDKey. The release notes live inside
	     the feed (a signed feed cannot vouch for a link). SURequireSignedFeed needs SUVerifyUpdateBeforeExtraction. -->
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
</dict>
</plist>
